{
  "info": {
    "name": "TicketRush API",
    "description": "Comprehensive Postman collection for TicketRush high-concurrency ticket booking platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "event_id", "value": "" },
    { "key": "seat_id", "value": "" },
    { "key": "hold_id", "value": "" },
    { "key": "booking_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"attendee@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/register" }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"attendee@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login" }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/events?status=on_sale&limit=10"
            }
          }
        },
        {
          "name": "Get Event By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/events/{{event_id}}" }
          }
        }
      ]
    },
    {
      "name": "Booking",
      "item": [
        {
          "name": "Get Seat Availability Map",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/booking/events/{{event_id}}/seats" }
          }
        },
        {
          "name": "Create Atomic Hold (10 min)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('hold_id', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{event_id}}\",\n  \"seat_ids\": [\"{{seat_id}}\"]\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/booking/holds" }
          }
        },
        {
          "name": "Create Idempotent Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Idempotency-Key", "value": "idem-uuid-12345" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hold_id\": \"{{hold_id}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/booking/bookings" }
          }
        }
      ]
    }
  ]
}
