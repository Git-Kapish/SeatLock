# ==============================================================================
# TicketRush Environment Configuration Template
# DO NOT commit actual secrets to version control.
# Copy this file to .env and customize values for local development.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# PostgreSQL Database (Single instance with separate schemas: auth, events, booking)
POSTGRES_USER=ticketrush
POSTGRES_PASSWORD=ticketrush
POSTGRES_DB=ticketrush
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ticketrush:ticketrush@localhost:5432/ticketrush

# Redis (Caching, distributed locks, rate limiting, token revocations)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=development-insecure-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal Service-to-Service Communication
INTERNAL_SERVICE_SECRET=development-internal-service-shared-secret-key

# Service URLs (for local gateway and inter-service HTTP calls)
AUTH_SERVICE_URL=http://localhost:8001
EVENTS_SERVICE_URL=http://localhost:8002
BOOKING_SERVICE_URL=http://localhost:8003

# AWS / LocalStack SQS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_NAME=ticketrush-booking-events
SQS_DLQ_NAME=ticketrush-booking-events-dlq
SQS_QUEUE_URL=http://localhost:4566/000000000000/ticketrush-booking-events
SQS_DLQ_URL=http://localhost:4566/000000000000/ticketrush-booking-events-dlq

# Payment Gateway / Webhook
PAYMENT_WEBHOOK_SECRET=development-payment-webhook-secret-key-min-32-chars

# Email / Notifications (MailHog locally on port 1025, AWS SES in production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=notifications@ticketrush.dev
SMTP_FROM_NAME=TicketRush

# Metrics & Monitoring
METRICS_ENABLED=true
